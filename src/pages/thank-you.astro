---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Thanks — we've got your message | The Nova Group"
  description="Your message has been received. A member of The Nova Group will be in touch shortly."
  noindex
>
  <section class="section thank-you">
    <div class="container thank-you-inner">
      <span class="eyebrow">Message received</span>
      <h1 class="section-title">Thanks — we've got your message</h1>
      <p class="section-lead">
        A member of our team will be in touch shortly. In the meantime, feel free
        to explore our latest thinking or head back to the homepage.
      </p>
      <div class="thank-you-actions">
        <a href="/" class="thank-you-cta">Back to homepage</a>
        <a href="/blog" class="thank-you-link">Read our insights →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thank-you {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .thank-you::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 30%, rgba(255, 77, 46, 0.08), transparent 45%),
      radial-gradient(circle at 80% 70%, rgba(255, 180, 0, 0.06), transparent 45%);
    pointer-events: none;
  }
  .thank-you-inner {
    position: relative;
    text-align: center;
    max-width: 720px;
  }
  .thank-you .section-title { margin-bottom: 1.25rem; }
  .thank-you-actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    align-items: center;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }
  .thank-you-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2.25rem;
    color: #ffffff;
    border: 1.5px solid transparent;
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      linear-gradient(90deg, var(--accent-red) 0%, #ffffff 50%, var(--accent-red) 100%) border-box;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1;
    border-radius: 999px;
    transition: filter 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .thank-you-cta:hover {
    filter: brightness(1.15);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(255, 77, 46, 0.35);
  }
  .thank-you-link {
    color: var(--muted);
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }
  .thank-you-link:hover { color: var(--text); }
</style>
