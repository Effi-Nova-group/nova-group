---
import BaseLayout from '../layouts/BaseLayout.astro';
import Marquee from '../components/Marquee.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const brands = [
  { href: 'https://nova4you.com.au/', name: 'Nova', domain: 'nova4you.com.au', img: '/images/Screenshot-2026-07-24-at-10.30.50-am-1.png' },
  { href: 'https://www.enova.com.au', name: 'Enova', domain: 'enova.com.au', img: '/images/Screenshot-2026-07-24-at-10.31.19-am-1.png' },
  { href: 'https://novatools.io/', name: 'Novatools', domain: 'novatools.io', img: '/images/Screenshot-2026-07-24-at-10.31.30-am-1.png' },
  { href: 'https://daronet.com.au/', name: 'Daronet', domain: 'daronet.com.au', img: '/images/Group-1.png' },
  { href: 'https://turbamedia.io/', name: 'Turba Media', domain: 'turbamedia.io', img: '/images/images-1.png' },
];

const siteUrl = 'https://www.thenovagroup.com.au';
const logoUrl = `${siteUrl}/images/the_nova_group_aus_logo-1.png`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'The Nova Group',
  legalName: 'The Nova Group',
  url: `${siteUrl}/`,
  logo: {
    '@type': 'ImageObject',
    url: logoUrl,
  },
  description: 'The Nova Group is an award-winning marketing and media agency with over 30 years of heritage — home to Nova, Enova, Novatools, Daronet and Turba Media.',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'AU',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+61-1300-926-895',
    contactType: 'customer service',
    areaServed: 'AU',
    availableLanguage: 'English',
  },
  subOrganization: brands.map((b) => ({
    '@type': 'Organization',
    name: b.name,
    url: b.href,
  })),
};
---
<BaseLayout
  title="The Nova Group | Award-Winning Marketing & Media Agency"
  description="The Nova Group is an award-winning marketing and media agency with over 30 years of heritage — home to Nova, Enova, Novatools, Daronet and Turba Media."
  schema={schema}
>
  <section class="hero">
    <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="/images/hero-poster.jpg">
      <source src="/16273480_1920_1080_60fps.mp4" type="video/mp4">
    </video>
    <canvas class="hero-canvas" aria-hidden="true"></canvas>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="hero-title">We inspire brands and people to impact the world</h1>
    </div>
  </section>

  <script>
    // iOS Safari + mobile Chrome cache the blend layer when mix-blend-mode
    // is applied over <video>, freezing the text on the first frame. Fix by
    // rendering the entire effect inside <canvas>: draw the current video
    // frame, then composite the text on top with globalCompositeOperation
    // 'exclusion' (mirrors the desktop mix-blend-mode:exclusion). Canvas
    // repaints every frame so nothing gets cached.
    if (window.matchMedia('(max-width: 767px)').matches) {
      const video = document.querySelector('.hero-video') as HTMLVideoElement | null;
      const canvas = document.querySelector('.hero-canvas') as HTMLCanvasElement | null;
      const hero = document.querySelector('.hero') as HTMLElement | null;
      const heroTitle = document.querySelector('.hero-title') as HTMLElement | null;

      if (video && canvas && hero && heroTitle) {
        const ctx = canvas.getContext('2d');
        const dpr = Math.min(window.devicePixelRatio || 1, 2);

        const resize = () => {
          const rect = hero.getBoundingClientRect();
          canvas.width = Math.floor(rect.width * dpr);
          canvas.height = Math.floor(rect.height * dpr);
          canvas.style.width = rect.width + 'px';
          canvas.style.height = rect.height + 'px';
        };

        const wrap = (text: string, maxWidth: number): string[] => {
          if (!ctx) return [text];
          const words = text.split(/\s+/);
          const lines: string[] = [];
          let line = words[0] || '';
          for (let i = 1; i < words.length; i++) {
            const test = line + ' ' + words[i];
            if (ctx.measureText(test).width <= maxWidth) {
              line = test;
            } else {
              lines.push(line);
              line = words[i];
            }
          }
          if (line) lines.push(line);
          return lines;
        };

        const draw = () => {
          if (!ctx) return;
          if (video.readyState >= 2 && video.videoWidth) {
            const w = canvas.width;
            const h = canvas.height;

            // 1. Video frame (object-fit: cover math)
            ctx.globalCompositeOperation = 'source-over';
            ctx.clearRect(0, 0, w, h);
            const vw = video.videoWidth;
            const vh = video.videoHeight;
            const scale = Math.max(w / vw, h / vh);
            const dw = vw * scale;
            const dh = vh * scale;
            ctx.drawImage(video, (w - dw) / 2, (h - dh) / 2, dw, dh);

            // 2. Text composited over video with exclusion blend
            const cs = getComputedStyle(heroTitle);
            const fontSize = parseFloat(cs.fontSize) * dpr;
            const fontWeight = cs.fontWeight || '800';
            const fontFamily = cs.fontFamily || 'Inter, sans-serif';
            const lineHeight = fontSize * 1.02;

            ctx.font = `${fontWeight} ${fontSize}px ${fontFamily}`;
            ctx.textBaseline = 'top';
            ctx.fillStyle = '#ffffff';

            const heroRect = hero.getBoundingClientRect();
            const titleRect = heroTitle.getBoundingClientRect();
            const x = (titleRect.left - heroRect.left) * dpr;
            const y = (titleRect.top - heroRect.top) * dpr;
            const maxWidth = Math.max(titleRect.width * dpr, 100);

            const text = (heroTitle.textContent || '').trim().toUpperCase();
            const lines = wrap(text, maxWidth);

            ctx.globalCompositeOperation = 'exclusion';
            lines.forEach((line, i) => {
              ctx.fillText(line, x, y + i * lineHeight);
            });
            ctx.globalCompositeOperation = 'source-over';
          }
          requestAnimationFrame(draw);
        };

        resize();
        window.addEventListener('resize', resize);
        video.addEventListener('loadedmetadata', resize);
        video.play().catch(() => {});
        requestAnimationFrame(draw);
      }
    }
  </script>

  <section id="about" class="section brands">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">About</span>
        <h2 class="section-title">The Nova Group</h2>
        <p class="section-lead">Shaped local culture through iconic marketing for more than three decades. Today, the award-winning agency continues to redefine industry standards by blending deep heritage with modern, data-driven innovation.</p>
      </div>
      <div id="brands" class="brand-grid reveal">
        {brands.map((brand) => (
          <a href={brand.href} target="_blank" rel="noopener" class="brand-card">
            <div class="brand-card-media"><img src={brand.img} alt={brand.name} loading="lazy" decoding="async"></div>
            <div>
              <div class="brand-card-name">{brand.name}</div>
              <div class="brand-card-domain">{brand.domain}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Marquee />

  <section id="insights" class="insights">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Insights</span>
        <h2 class="section-title">Ideas that shape modern marketing</h2>
        <p class="section-lead">Strategy, behavioral science, and data-driven innovation — the thinking behind our work.</p>
      </div>
      <div class="insights-grid reveal">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="insight-card">
            <div class="insight-card-media"><Image src={post.data.image} alt={post.data.title} widths={[400, 640, 900]} sizes="(max-width: 620px) 100vw, (max-width: 991px) 50vw, 400px" loading="lazy" /></div>
            <div class="insight-card-body">
              <span class="insight-card-category" set:html={post.data.category}></span>
              <h3 class="insight-card-title">{post.data.title}</h3>
              <p class="insight-card-excerpt">{post.data.excerpt}</p>
              <div class="insight-card-meta">
                <span>{post.data.readTime}</span>
                <span class="insight-card-link">Read article</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="insights-cta reveal">
        <a href="/blog">View all articles</a>
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="contact-inner">
      <div class="toll-free reveal">Toll Free<a href="tel:1300926895">1 300 926 895</a></div>
      <div class="hs-form-wrap reveal">
        <script src="https://js.hsforms.net/forms/embed/44484340.js" defer></script>
        <div class="hs-form-frame" data-region="na1" data-form-id="68e1f3c6-b6a3-42fe-a699-b0cc17730c7c" data-portal-id="44484340"></div>
      </div>
    </div>
  </section>
</BaseLayout>
