---
import BaseLayout from '../layouts/BaseLayout.astro';
import Marquee from '../components/Marquee.astro';
import PhoneInput from '../components/PhoneInput.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const brands = [
  { href: 'https://nova4you.com.au/', name: 'Nova', domain: 'nova4you.com.au', img: '/images/Screenshot-2026-07-24-at-10.30.50-am-1.png' },
  { href: 'https://www.enova.com.au', name: 'Enova', domain: 'enova.com.au', img: '/images/Screenshot-2026-07-24-at-10.31.19-am-1.png' },
  { href: 'https://novatools.io/', name: 'Novatools', domain: 'novatools.io', img: '/images/Screenshot-2026-07-24-at-10.31.30-am-1.png' },
  { href: 'https://daronet.com.au/', name: 'Daronet', domain: 'daronet.com.au', img: '/images/Group-1.png' },
  { href: 'https://turbamedia.io/', name: 'Turba Media', domain: 'turbamedia.io', img: '/images/images-1.png' },
];

const siteUrl = 'https://www.thenovagroup.com.au';
const logoUrl = `${siteUrl}/images/the_nova_group_aus_logo-1.png`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'The Nova Group',
  legalName: 'The Nova Group',
  url: `${siteUrl}/`,
  logo: {
    '@type': 'ImageObject',
    url: logoUrl,
  },
  description: 'The Nova Group is an award-winning marketing and media agency with over 30 years of heritage — home to Nova, Enova, Novatools, Daronet and Turba Media.',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'AU',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+61-1300-926-895',
    contactType: 'customer service',
    areaServed: 'AU',
    availableLanguage: 'English',
  },
  subOrganization: brands.map((b) => ({
    '@type': 'Organization',
    name: b.name,
    url: b.href,
  })),
};
---
<BaseLayout
  title="The Nova Group | Award-Winning Marketing & Media Agency"
  description="The Nova Group is an award-winning marketing and media agency with over 30 years of heritage — home to Nova, Enova, Novatools, Daronet and Turba Media."
  schema={schema}
>
  <section class="hero">
    <div class="hero-video-wrap">
      <iframe
        id="hero-yt-player"
        src="https://www.youtube-nocookie.com/embed/rEhW2_aorHo?autoplay=1&mute=1&loop=1&playlist=rEhW2_aorHo&controls=0&disablekb=1&fs=0&iv_load_policy=3&modestbranding=1&playsinline=1&rel=0&showinfo=0&enablejsapi=1"
        title="Background video"
        frameborder="0"
        allow="autoplay; encrypted-media"
        aria-hidden="true"
        tabindex="-1"
      ></iframe>
    </div>
    <div class="hero-overlay"></div>
    <button type="button" id="hero-mute-toggle" class="hero-mute-toggle" aria-label="Unmute video" aria-pressed="true">
      <svg class="icon-muted" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor"/>
        <path d="M16.5 8.5a5 5 0 0 1 0 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <line x1="18.5" y1="6" x2="21.5" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <line x1="21.5" y1="6" x2="18.5" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
      <svg class="icon-unmuted" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor"/>
        <path d="M16.5 8.5a5 5 0 0 1 0 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <path d="M19 6a9 9 0 0 1 0 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
  </section>

  <script>
    // Background video is a plain autoplaying/looping YouTube iframe (no
    // iframe_api.js load, so it starts immediately). Mute is toggled with a
    // raw postMessage to the embed's postMessage command API, which the
    // embed already listens for once enablejsapi=1 is set — no extra script.
    const iframe = document.getElementById('hero-yt-player') as HTMLIFrameElement | null;
    const toggle = document.getElementById('hero-mute-toggle') as HTMLButtonElement | null;
    let muted = true;

    const updateToggle = () => {
      if (!toggle) return;
      toggle.classList.toggle('is-muted', muted);
      toggle.setAttribute('aria-pressed', String(muted));
      toggle.setAttribute('aria-label', muted ? 'Unmute video' : 'Mute video');
    };
    updateToggle();

    const sendCommand = (func: string) => {
      iframe?.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args: [] }), '*');
    };

    toggle?.addEventListener('click', () => {
      muted = !muted;
      sendCommand(muted ? 'mute' : 'unMute');
      updateToggle();
    });
  </script>

  <section id="about" class="section brands">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">About</span>
        <h2 class="section-title">The Nova Group</h2>
        <p class="section-lead">Shaped local culture through iconic marketing for more than three decades. Today, the award-winning agency continues to redefine industry standards by blending deep heritage with modern, data-driven innovation.</p>
      </div>
      <div id="brands" class="brand-grid reveal">
        {brands.map((brand) => (
          <a href={brand.href} target="_blank" rel="noopener" class="brand-card">
            <div class="brand-card-media"><img src={brand.img} alt={brand.name} loading="lazy" decoding="async"></div>
            <div>
              <div class="brand-card-name">{brand.name}</div>
              <div class="brand-card-domain">{brand.domain}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Marquee />

  <section id="insights" class="insights">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Insights</span>
        <h2 class="section-title">Ideas that shape modern marketing</h2>
        <p class="section-lead">Strategy, behavioral science, and data-driven innovation — the thinking behind our work.</p>
      </div>
      <div class="insights-grid reveal">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="insight-card">
            <div class="insight-card-media"><Image src={post.data.image} alt={post.data.title} widths={[400, 640, 900]} sizes="(max-width: 620px) 100vw, (max-width: 991px) 50vw, 400px" loading="lazy" /></div>
            <div class="insight-card-body">
              <span class="insight-card-category" set:html={post.data.category}></span>
              <h3 class="insight-card-title">{post.data.title}</h3>
              <p class="insight-card-excerpt">{post.data.excerpt}</p>
              <div class="insight-card-meta">
                <span>{post.data.readTime}</span>
                <span class="insight-card-link">Read article</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="insights-cta reveal">
        <a href="/blog">View all articles</a>
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="contact-inner">
      <div class="toll-free reveal">Toll Free<a href="tel:1300926895">1 300 926 895</a></div>
      <form class="contact-form reveal" action="https://api.web3forms.com/submit" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="access_key" value="4b7cdb9d-2ae5-40b9-9247-c6dbdd0e3edf">
        <input type="hidden" name="subject" value="New enquiry from thenovagroup.com.au">
        <input type="hidden" name="from_name" value="The Nova Group Website">
        <input type="hidden" name="redirect" value="https://www.thenovagroup.com.au/thank-you">
        <input type="checkbox" name="botcheck" class="contact-form-honeypot" tabindex="-1" autocomplete="off">

        <div class="contact-form-row">
          <div class="contact-form-field">
            <label for="contact-first-name">First Name*</label>
            <input id="contact-first-name" type="text" name="first_name" autocomplete="given-name" required>
          </div>
          <div class="contact-form-field">
            <label for="contact-last-name">Last Name*</label>
            <input id="contact-last-name" type="text" name="last_name" autocomplete="family-name" required>
          </div>
        </div>

        <div class="contact-form-field">
          <label for="contact-email">Business Email*</label>
          <input id="contact-email" type="email" name="email" autocomplete="email" required>
        </div>

        <div class="contact-form-field">
          <label for="contact-company">Company Name*</label>
          <input id="contact-company" type="text" name="company" autocomplete="organization" required>
        </div>

        <PhoneInput id="contact-phone" name="phone" label="Phone Number*" required />

        <button type="submit" class="contact-form-submit">Book a Strategy Call</button>
      </form>
    </div>
  </section>
</BaseLayout>
